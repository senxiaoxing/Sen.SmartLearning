 },
 "petline.dragonG1LevelUp2": {
  "text": "快看，本龙的角！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.dragonG1Comeback0": {
  "text": "好久不见，本龙甚是想念",
