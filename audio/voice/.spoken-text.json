 },
 "petline.dragonG1Correct2": {
  "text": "读得真好听～",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.dragonG1Correct3": {
  "text": "你比本龙还厉害！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.dragonG1Wrong0": {
  "text": "无妨无妨，再想想",
