 "petline.penguinG1Catchphrase": {
  "text": "让我数数看～",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Greet0": {
  "text": "今天也来数数吗？",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Greet1": {
  "text": "我刚才数到 100 啦！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Greet2": {
  "text": "你来啦，我等你好久了～",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Greet3": {
  "text": "一起做数学题吧！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Correct0": {
  "text": "哇，算对了！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Correct1": {
  "text": "你比我还快！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Correct2": {
  "text": "让我数数看…没错！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Correct3": {
  "text": "厉害厉害～",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Wrong0": {
  "text": "嗯…我们再看看",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Wrong1": {
  "text": "这道题有点绕呢",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Wrong2": {
  "text": "没关系，我也常常数错",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Wrong3": {
  "text": "再想想，你可以的",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1LevelUp0": {
  "text": "我长大啦！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1LevelUp1": {
  "text": "又进步了一点点～",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1LevelUp2": {
  "text": "快看快看，我不一样了！",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Comeback0": {
  "text": "好几天没见到你了，我有点想你",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Comeback1": {
  "text": "你回来啦！我一直在等你",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.penguinG1Comeback2": {
  "text": "想你想得都不会数数了～",
  "sig": "zh-CN-XiaoyiNeural|-15%|+5%"
 },
 "petline.dragonG1Catchphrase": {
  "text": "本龙又学会一个字！",
