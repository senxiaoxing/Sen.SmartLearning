{
  "name": "sen-smartlearning",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "智慧学习 App — 一年级数学/拼音/英语 + 宠物养成，PWA 纯本地",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "sfx": "node scripts/generate-sfx.mjs",
    "voices": "node scripts/generate-voices.mjs",
    "pinyin:check": "node scripts/generate-pinyin-check.mjs",
    "pinyin:record": "node scripts/generate-pinyin-record.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "framer-motion": "^12.43.0",
    "howler": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.0.1",
    "msedge-tts": "^2.0.7",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
